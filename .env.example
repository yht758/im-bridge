# ============================================================
# 轻量 LLM 拟真聊天桥接器 - 环境变量示例
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不会提交。
# 优先级：环境变量 > .env > config.secret.json > config.json
# ============================================================

# ---------- 必填 ----------
# LLM API Key（DeepSeek / OpenAI / 任意 OpenAI 兼容服务）
AMIS_API_KEY=

# ---------- LLM ----------
# OpenAI 兼容的接口地址（不要带 /chat/completions）
AMIS_BASE_URL=
AMIS_MODEL=

# ---------- 账号与权限 ----------
# 机器人自己的 QQ 号（仅用于展示/日志，占位即可）
AMIS_BOT_QQ=
# 是否响应群聊消息（当前适配器只处理私聊，保留开关）
AMIS_RESPOND_TO_GROUPS=false
# 白名单：逗号分隔的 QQ 号；留空表示不限制
AMIS_ALLOWED_USERS=
# 管理员：逗号分隔的 QQ 号，可执行 /status /allow /deny /log /stop
AMIS_ADMIN_USERS=

# ---------- OneBot / NapCat 连接 ----------
AMIS_NAPCAT_WS_URL=ws://127.0.0.1:3001

# ---------- 上下文（Summary Buffer） ----------
# 上下文窗口保留的消息条数上限（约 max/2 轮对话）
AMIS_MAX_HISTORY=40
# 是否启用历史摘要压缩
AMIS_SUMMARY_ENABLED=true
# 消息条数超过该值后触发压缩（必须大于 KEEP_RECENT 且小于 MAX_HISTORY）
AMIS_SUMMARY_THRESHOLD=24
# 压缩后保留的最近消息条数
AMIS_SUMMARY_KEEP_RECENT=8
# 摘要是否放到后台异步执行（true 不阻塞回复，推荐）
AMIS_SUMMARY_ASYNC=true
# 按 token 估算触发摘要的阈值（中文约 1 字 ≈ 1 token）
AMIS_SUMMARY_TOKEN_THRESHOLD=1800

# 是否记录每次 LLM 调用的 token 用量（写入 data/usage/，供桌面端统计花费）
AMIS_USAGE_ENABLED=true

# ---------- 输出节奏（模拟真人打字） ----------
# 是否使用 SSE 流式接收
AMIS_STREAMING_ENABLED=true
# 是否按标点把回复切成多条短消息
AMIS_CHUNKING_ENABLED=true
# 两条消息之间的随机间隔（秒）
AMIS_CHUNK_MIN_DELAY=1.0
AMIS_CHUNK_MAX_DELAY=2.0
# 单次回复最多分几条（0 表示不限制，太多会刷屏）
AMIS_CHUNK_MAX_SEGMENTS=8
# 单条消息字数上限，超过会自动拆条（QQ 建议不超过 1500）
AMIS_MESSAGE_MAX_CHARS=1000

# ---------- 主动会话（默认关闭） ----------
# 是否允许 bot 在合适时机主动搭话
AMIS_PROACTIVE_ENABLED=false
# 闲置多少小时后可主动搭话
AMIS_PROACTIVE_IDLE_HOURS=24
# 每人每天最多主动几条（0 表示不主动）
AMIS_PROACTIVE_MAX_PER_DAY=1
# 静默时段，格式 HH:MM-HH:MM，可跨零点；留空表示不限制
AMIS_PROACTIVE_QUIET_HOURS=23:00-08:00
# 主动对话对象：逗号分隔的 QQ 号；留空表示不主动发任何人（避免打扰不熟的好友）
AMIS_PROACTIVE_TARGETS=
# 到点后再随机等 0~N 分钟才开口，避免每天同一时刻像定时任务
AMIS_PROACTIVE_JITTER_MINUTES=120

# ---------- 语音（默认关闭） ----------
# 是否把收到的语音消息转写成文字（需要 ASR 接口）
AMIS_VOICE_INPUT_ENABLED=false
# 是否用语音回复（需要 TTS 接口）
AMIS_VOICE_REPLY_ENABLED=false
# 语音回复概率：每条文字回复后，按该概率再补一条语音（0~1）
AMIS_VOICE_REPLY_PROBABILITY=0.35
# OpenAI 兼容的语音转写地址，例如 https://api.openai.com/v1/audio/transcriptions
AMIS_ASR_ENDPOINT=
# 留空则复用 AMIS_API_KEY
AMIS_ASR_API_KEY=
# OpenAI 兼容的语音合成地址，例如 https://api.openai.com/v1/audio/speech
AMIS_TTS_ENDPOINT=
# 留空则复用 AMIS_API_KEY
# 语音合成模型与音色（按服务商文档填）
AMIS_TTS_MODEL=
AMIS_TTS_VOICE=
# 语音合成 Key，留空复用 AMIS_API_KEY
AMIS_TTS_API_KEY=
# 语音最长时长（秒），超过则忽略
AMIS_VOICE_MAX_SECONDS=60
# 语音文件路径映射：容器路径=宿主机路径，多个用逗号分隔
# NapCat 跑在 Docker 里时必须配置，否则 bot 读不到语音文件
AMIS_VOICE_PATH_MAP=/app/.config/QQ=/www/wwwroot/napcat/qq

AMIS_VOICE_MODE=local_tts
AMIS_LOCAL_TTS_PYTHON=
AMIS_LOCAL_TTS_SCRIPT=

AMIS_RVC_ENDPOINT=
AMIS_RVC_API_KEY=

# ---------- RVC 本地变声（电脑开机时启用，关机自动回退云端 TTS）----------
# 是否启用 RVC 本地变声：本机引擎可用时，语音回复会经 RVC 转成注册音色
AMIS_RVC_ENABLED=true
# 本机不可用时的回退策略：cloud=改用云 TTS 音色；off=不发语音
AMIS_RVC_FALLBACK=off
# RVC 转换脚本路径（脚本自带 rvc 引擎引用）
AMIS_RVC_CONVERT_SCRIPT=
# 运行转换脚本的解释器（独立 venv，含 torch cu128）
AMIS_RVC_PYTHON=
# 默认本地音色 ID（voices 注册表中的 id，/voice use 可切换）
AMIS_RVC_DEFAULT_VOICE=
# 特征索引强度（0~1），越大越贴近目标音色
AMIS_RVC_INDEX_RATE=0.75
# 音高提取算法：rmvpe 或 pm
AMIS_RVC_F0_METHOD=rmvpe
# 变调半音数（正负整数，0 不变调）
AMIS_RVC_PITCH=0
# RVC 推理设备：auto / gpu / cpu
AMIS_RVC_DEVICE=auto

# ---------- 图片识别（默认开）----------
# 入站图片会先转成文字描述再交给模型；接口不支持视觉时设为 false
AMIS_IMAGE_INPUT_ENABLED=true
# 视觉接口地址，只写到 /v1；留空复用 AMIS_BASE_URL
AMIS_VISION_ENDPOINT=
# 留空复用 AMIS_API_KEY
AMIS_VISION_API_KEY=
# 留空复用 AMIS_MODEL（模型必须支持图片输入）
AMIS_VISION_MODEL=
# 超过该体积（字节）的图片跳过识别
AMIS_VISION_MAX_BYTES=8000000
# 单条消息最多识别几张图
AMIS_IMAGE_MAX_COUNT=4

# ---------- 人设 ----------
# 内置：aemeath；也可以写成 .txt / .md 提示词文件的路径
AMIS_PERSONA=aemeath

# ---- 表情包（默认关闭；素材放 data/stickers/，index.json 或标签目录均可）----
AMIS_STICKER_ENABLED=false
AMIS_STICKER_PROBABILITY=0.25
AMIS_STICKER_COOLDOWN=180
AMIS_STICKER_MAX_PER_DAY=30
